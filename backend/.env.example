# REAI_CHAT_PROVIDER 선택: mock(시연), openai(API 연동)
REAI_CHAT_PROVIDER=mock
# ChatGPT 계정 연결은 04_run_pc_share.bat chatgpt로 실행합니다.
OPENAI_API_KEY=
OPENAI_MODEL=

# 계정 복구 메일 발송 설정. 발신 서비스가 지정한 포트와 암호화 방식을 사용합니다.
# REAI_SMTP_HOST=
# REAI_SMTP_SECURITY=starttls
# REAI_SMTP_PORT=587
# REAI_SMTP_FROM=
# REAI_SMTP_USERNAME=
# REAI_SMTP_PASSWORD=
# 고정 주소를 운영하는 경우에 설정합니다. 05_run_team_share.bat은 임시 팀 주소를 자동으로 사용합니다.
# REAI_RECOVERY_BASE_URL=

# 허가 정보를 확인하는 운영자 아이디(쉼표로 여러 개). 이 아이디로 로그인하면 '허가 정보 확인' 메뉴가 보입니다.
# REAI_OPERATOR_USERNAMES=operator
# 팀원 에이전트를 매칭·거래 화면에 연결할 때 지정합니다. 형식: 패키지.모듈:클래스 (docs/AGENT_INTEGRATION.md 참고)
# REAI_MATCHING_AGENT=
